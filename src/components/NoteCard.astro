---
const {note}=Astro.props;
const d=note.data;
const year=d.date.getFullYear();
---
<article class="note-row">
  <div class="note-main">
    <div class="note-meta"><span>{d.topic}</span>{d.pages && <span>· {d.pages} pages</span>}<span>· {year}</span>{d.complete && <span class="complete-label">Complete</span>}</div>
    <h3><a href={`/notes/${note.id}/`}>{d.title}</a></h3>
    <p class="note-description">{d.description}</p>
    <details class="note-details"><summary>Contents &amp; details</summary><div class="details-inner"><p>{d.description}</p>{d.tags.length>0 && <p><strong>Topics:</strong> {d.tags.join(' · ')}</p>}<a class="text-link" href={`/notes/${note.id}/`}>Full overview →</a></div></details>
  </div>
  <div class="note-actions">
    {d.pdf && <a class="pdf-button" href={d.pdf} target="_blank" rel="noopener noreferrer">Read PDF <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span></a>}
    {d.pdf && <a class="download-link" href={d.pdf} download>Download ↓</a>}
  </div>
</article>
