---
// Same design and behavior for publications and notes. Only the data differs.
// categories: [{ id, title, count }]; the selected area is kept in the URL as ?area=<id>.
const { id, placeholder, categories=[], keywords=[], count=0 }=Astro.props;
---
<section class="archive-controls" data-search-controls={id} aria-label={`Search and filter ${id}`}>
  <div class="archive-tabs" role="group" aria-label="Browse by area">
    <button type="button" class="archive-tab" data-area-filter="all" aria-pressed="true">All <span class="tab-count">{count}</span></button>
    {categories.map(x=><button type="button" class="archive-tab" data-area-filter={x.id} aria-pressed="false">{x.title} <span class="tab-count">{x.count}</span></button>)}
  </div>
  <div class="archive-search-row">
    <div class="search-input">
      <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.6"/><path d="m16 16 4.2 4.2"/></svg>
      <label class="sr-only" for={`${id}-search`}>Search</label>
      <input id={`${id}-search`} data-text-filter type="search" placeholder={placeholder} autocomplete="off" aria-controls={`${id}-results`} />
    </div>
    {keywords.length>0 && <details class="keyword-panel">
      <summary data-keyword-summary>Keywords</summary>
      <div class="filter-buttons keyword-buttons" role="group" aria-label="Keywords">
        <button type="button" data-keyword-filter="all" aria-pressed="true">All topics</button>
        {keywords.map(tag=><button type="button" data-keyword-filter={tag} aria-pressed="false">{tag}</button>)}
      </div>
    </details>}
  </div>
</section>
