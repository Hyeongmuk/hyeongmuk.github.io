---
import SiteLayout from '../layouts/SiteLayout.astro';
import PaperCard from '../components/PaperCard.astro';
import {featuredPublications} from '../lib/publications.mjs';
import {getCollection} from 'astro:content';
const notes=(await getCollection('notes',({data})=>data.status==='published')).sort((a,b)=>a.data.category.localeCompare(b.data.category));
---
<SiteLayout active="home" page="home">
  <section class="home-hero">
    <div class="hero-main">
      <p class="eyebrow"><span class="dot"></span>THEORETICAL CONDENSED MATTER PHYSICS</p>
      <h1>Hyeongmuk Lim <span class="name-alias">(Mook)</span></h1>
      <p class="hero-copy">I explore how the geometry and topology of quantum states shape physical phenomena in solids, from band structures to correlated quantum matter.</p>
      <div class="hero-actions"><a class="button" href="/research/">Explore research ↗</a><a class="underlined-link" href="/publications/">Selected publications →</a></div>
      <p class="home-affiliation">Department of Physics and Astronomy · Seoul National University</p>
    </div>
  </section>
  <section class="home-research">
    <div class="section-heading"><div><p class="eyebrow">RESEARCH</p><h2>Questions I work on</h2></div><a class="text-link" href="/research/">All research →</a></div>
    <div class="research-strip">
      <a href="/research/#geometry"><span class="eyebrow">01 / GEOMETRY</span><strong>Quantum Geometry</strong><span>How Bloch wave-function geometry constrains electronic response and correlations.</span></a>
      <a href="/research/#topology"><span class="eyebrow">02 / TOPOLOGY</span><strong>Band Topology</strong><span>Topological structures that go beyond the usual classification of band insulators.</span></a>
      <a href="/research/#manybody"><span class="eyebrow">03 / QUANTUM MATTER</span><strong>Many-Body Physics</strong><span>Interaction effects and geometry-driven electronic phenomena.</span></a>
    </div>
  </section>
  <section class="home-publications">
    <div class="section-heading"><div><p class="eyebrow">SELECTED WORK</p><h2>Publications</h2></div><a class="text-link" href="/publications/">All publications →</a></div>
    <div class="papers-list">{featuredPublications.slice(0,3).map(paper=><PaperCard paper={paper} compact />)}</div>
  </section>
  <section class="home-notes">
    <div class="section-heading"><div><p class="eyebrow">OPEN NOTES</p><h2>Learning in public</h2></div><a class="text-link" href="/notes/">All study notes →</a></div>
    <p class="section-intro">Personal study notes in quantum field theory, mathematics, and condensed matter physics. Read manuscripts online or download their PDFs.</p>
    <div class="small-notes">
      {notes.slice(0,3).map(note=><div class="small-note"><div><p class="eyebrow">{note.data.topic}</p><h3><a href={`/notes/${note.id}/`}>{note.data.title}</a></h3></div><a class="small-link" href={`/notes/${note.id}/`}>Details ↗</a></div>)}
    </div>
  </section>
</SiteLayout>
