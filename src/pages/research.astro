---
import SiteLayout from '../layouts/SiteLayout.astro';
import PaperCard from '../components/PaperCard.astro';
import {publications} from '../lib/publications.mjs';
const sections=[
 {id:'geometry',label:'01 / GEOMETRY',title:'Quantum Geometry',question:'What information about electronic states is invisible to band energies?',text:'Quantum geometry describes how Bloch wave functions vary in momentum space. I study its relation to topological structure, electronic response, and correlated phenomena, especially in multiband systems.',tag:'Quantum Geometry'},
 {id:'topology',label:'02 / TOPOLOGY',title:'Band Topology',question:'What kinds of topology arise beyond conventional band invariants?',text:'My work concerns topological structures of quantum bands, including Hopf invariants and the role of wave-function structure in unconventional topological phase transitions.',tag:'Band Topology'},
 {id:'manybody',label:'03 / QUANTUM MATTER',title:'Many-Body Physics',question:'How does band geometry influence interacting quantum matter?',text:'I investigate geometric perspectives on interaction-driven electronic phases, with an interest in narrowing the gap between band topology and many-body phenomena.',tag:'Many-Body Physics'}
];
---
<SiteLayout active="research" page="research" title="Research · Hyeongmuk Lim">
<header class="page-heading"><p class="eyebrow">RESEARCH DIRECTIONS</p><h1>Research<span class="title-dot">.</span></h1><p>Understanding quantum matter through the geometry, topology, and interactions of electronic states.</p></header>
<section class="research-sections">{sections.map(section=><article class="research-chapter" id={section.id}><span class="chapter-label">{section.label}</span><div><h2>{section.title}</h2><p class="chapter-question">{section.question}</p><p>{section.text}</p><div class="related-papers"><h3>Related work</h3>{publications.filter(p=>p.area===section.tag).slice(0,3).map(p=><PaperCard paper={p} compact />)}{!publications.some(p=>p.area===section.tag)&&<p>Research in progress.</p>}</div></div></article>)}</section>
</SiteLayout>
