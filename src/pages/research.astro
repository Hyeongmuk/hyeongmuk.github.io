---
import SiteLayout from '../layouts/SiteLayout.astro';
import PaperCard from '../components/PaperCard.astro';
import NoteCard from '../components/NoteCard.astro';
import {researchPublications} from '../lib/publications.mjs';
import {getCollection} from 'astro:content';
import research from '../data/research.json';
const {sections}=research;
const publishedNotes=await getCollection('notes',({data})=>data.status==='published');
const notesFor=(section)=>(section.relatedNotes ?? []).map(id=>publishedNotes.find(n=>n.id===id)).filter(Boolean);
---
<SiteLayout active="research" page="research" title="Research · Hyeongmuk Lim" description="Research on quaternion-Kähler quantum geometry and delicate band topology, with broader interests in correlated quantum matter, topological order, and generalized symmetries.">
  <header class="page-heading"><p class="eyebrow">RESEARCH & DIRECTIONS</p><h1>Research<span class="title-dot">.</span></h1><p>How can the wave-function structure of noninteracting electrons shape correlated physics?</p></header>
  <section class="research-sections research-sections-refined">
    {sections.map(section=><article class="research-chapter" id={section.id}>
      <span class="chapter-label">{section.label}</span>
      <div><h2>{section.title}</h2><p class="chapter-question">{section.question}</p><p>{section.text}</p><p class="research-direction-note">{section.note}</p>
        {section.figure && (
          <figure class="research-figure">
            <a class="research-figure-visual" href={section.figure.src} target="_blank" rel="noopener noreferrer" aria-label={section.figure.ariaLabel}>
              <img
                src={section.figure.src}
                alt={section.figure.alt}
                width={section.figure.width} height={section.figure.height} loading="lazy" decoding="async"
              />
            </a>
            <figcaption>
              <div class="figure-caption-primary">
                <p class="figure-comparison">{section.figure.caption}</p>
                <a class="research-figure-expand" href={section.figure.src} target="_blank" rel="noopener noreferrer">View larger ↗</a>
              </div>
              <p class="figure-source">Associated paper: <a href={section.figure.paper.url} target="_blank" rel="noopener noreferrer"><cite>{section.figure.paper.title}</cite> ({section.figure.paper.year}) ↗</a></p>
            </figcaption>
          </figure>
        )}
        {section.area && researchPublications(section.area).length>0 && <div class="related-papers"><h3>Related publications</h3>{researchPublications(section.area).map(paper=><PaperCard paper={paper} compact />)}</div>}
        {notesFor(section).length>0 && <div class="related-notes-block"><h3>Related study notes</h3><div class="notes-results">{notesFor(section).map(note=><NoteCard note={note} />)}</div><p class="related-study-notes-disclaimer">These are personal study notes, not peer-reviewed publications.</p></div>}
      </div>
    </article>)}
  </section>
</SiteLayout>

<style>
  /* Research figures (one per section with `figure` data); no shared stylesheet changes. */
  .research-figure {
    width: min(100%, 820px);
    margin: 27px 0 33px;
  }
  .research-figure-visual {
    display: block;
    padding: clamp(10px, 2.5vw, 22px);
    border: 1px solid var(--line, #d9d9cc);
    border-radius: 4px;
    background: var(--surface, #fffcf6);
    transition: border-color .16s ease;
  }
  .research-figure-visual:hover { border-color: var(--accent, #285b49); }
  .research-figure-visual:focus-visible,
  .research-figure figcaption a:focus-visible {
    outline: 2px solid var(--accent, #285b49);
    outline-offset: 3px;
  }
  .research-figure-visual img {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    object-fit: contain;
  }
  .research-figure figcaption {
    display: block;
    padding-top: 12px;
    color: var(--muted, #5c665f);
    font: 12px/1.6 var(--sans, sans-serif);
  }
  /* Let the caption text use all space not occupied by View larger. */
  .research-figure .figure-caption-primary {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }
  .research-figure .figure-comparison {
    flex: 1 1 auto;
    min-width: 0;
    max-width: none;
    margin: 0;
  }
  .research-figure .research-figure-expand {
    flex: 0 0 auto;
    position: relative;
  }
  /* Enlarges the tap target without moving the caption. */
  .research-figure .research-figure-expand::after {
    content: ""; position: absolute; inset: -4px -2px;
  }
  .research-figure .figure-source {
    margin: 6px 0 0;
    font-size: 11.5px;
  }
  .research-figure .figure-source cite { font-style:italic; }
  /* Keep the subsection heading in sentence case. */
  /* The notes block avoids the `related-papers` class: its descendant h3 rule in
     site.css would also shrink NoteCard's nested titles. */
  .research-sections-refined .related-papers > h3,
  .related-notes-block > h3 {
    text-transform:none; letter-spacing:0; font-family:var(--serif,Georgia,serif);
    font-weight:500; font-size:19px; color:var(--ink,#263a33);
    margin-bottom:10px;
  }
  .related-study-notes-disclaimer {
    margin: 14px 0 0;
    font-size: 12px;
    color: var(--muted, #5c665f);
  }
  /* PaperCard is a child Astro component. :global is essential here:
     otherwise these selectors are scoped away and paper titles stay ALL CAPS. */
  :global(.page-research .related-papers .paper-row h3) {
    text-transform: none;
    letter-spacing: -.015em;
    font-family: var(--serif, Georgia, serif);
    font-weight: 500;
    color: var(--ink, #263a33);
  }
  :global(.page-research .related-papers .paper-row .paper-title) {
    text-transform: none;
    letter-spacing: inherit;
  }
  .research-figure figcaption a {
    color: var(--accent, #285b49);
    text-decoration: underline;
    text-underline-offset: 3px;
    white-space: nowrap;
  }
  /* Source links may wrap on phones without affecting the View larger link. */
  .research-figure .figure-source a { white-space: normal; overflow-wrap: anywhere; }
  @media (max-width: 600px) {
    .research-figure { margin: 23px 0 26px; }
    .research-figure-visual { padding: 8px; }
    .research-figure figcaption { font-size: 11.5px; }
    .research-figure .figure-caption-primary { flex-wrap:wrap; gap:5px 14px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .research-figure-visual { transition: none; }
  }
</style>
