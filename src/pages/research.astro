---
import SiteLayout from '../layouts/SiteLayout.astro';
import PaperCard from '../components/PaperCard.astro';
import {publications} from '../lib/publications.mjs';
const paperById=id=>publications.find(p=>p.id===id);
const sections=[
  {id:'geometry',label:'01 / ESTABLISHED RESEARCH',title:'Quantum Geometry',question:'Can the quantum geometry of noninteracting bands guide our understanding of correlated matter?',text:'Quantum geometry encodes how Bloch wave functions vary with momentum. For time-reversal-breaking Chern bands, Kähler geometry provides a framework for understanding ideal band geometry and its connection to fractional Chern insulators. Our work generalizes this geometric language to time-reversal-symmetric Kramers pairs: quaternion-Kähler structures and non-Abelian metric–curvature relations offer a starting point for asking analogous questions in systems that preserve time reversal.',note:'This framework provides a starting point for identifying geometric conditions relevant to time-reversal-symmetric correlated phases.',ids:['lim2026quaternion','jung2024quadratic']},
  {id:'topology',label:'02 / ESTABLISHED RESEARCH',title:'Band Topology',question:'What topological information is lost when we look only at the occupied bands?',text:'Some band-topological structures depend on the wave functions of both occupied and unoccupied states. In the real Hopf insulator, we characterized delicate three-dimensional topology in four-band systems with spinless PT symmetry, including independent Hopf invariants and associated boundary phenomena. I am also interested in the structure of unconventional topological phase transitions.',note:'These results highlight why the full multiband wave-function structure matters for topological classification.',ids:['lim2023hopf','kim2024unconventional']},
  {id:'manybody',label:'03 / BROADER RESEARCH INTERESTS',title:'Correlated Quantum Matter',question:'How do the traces of noninteracting band structure shape what emerges from electron correlations?',text:'My broader interests include correlations in electronic bands, topological order, symmetry-protected topological phases, and generalized symmetries. I hope to investigate how multiband quantum geometry can constrain or guide the emergence of time-reversal-symmetric correlated phases.',note:'A future direction is to connect single-particle geometric constraints with concrete many-body models and observables.',ids:[]}
];
---
<SiteLayout active="research" page="research" title="Research · Hyeongmuk Lim" description="Research on quaternion-Kähler quantum geometry and delicate band topology, with broader interests in correlated quantum matter, topological order, and generalized symmetries.">
  <header class="page-heading"><p class="eyebrow">RESEARCH & DIRECTIONS</p><h1>Research<span class="title-dot">.</span></h1><p>How can the wave-function structure of noninteracting electrons shape correlated physics?</p></header>
  <section class="research-sections research-sections-refined">
    {sections.map(section=><article class="research-chapter" id={section.id}>
      <span class="chapter-label">{section.label}</span>
      <div><h2>{section.title}</h2><p class="chapter-question">{section.question}</p><p>{section.text}</p><p class="research-direction-note">{section.note}</p>
        {section.id==='geometry' && (
          <figure class="geometry-research-figure">
            <a class="geometry-figure-visual" href="/research/quaternion-kahler-geometry.svg" target="_blank" rel="noopener noreferrer" aria-label="Open the quaternion-Kähler geometry research illustration in a new tab">
              <img
                src="/research/quaternion-kahler-geometry.svg"
                alt="Scientific illustration comparing quantum metric and Berry curvature in a two-dimensional Brillouin zone with a quaternion-Kähler setting in four dimensions featuring three coupled Berry curvatures."
                width="4329" height="2285" loading="lazy" decoding="async"
              />
            </a>
            <figcaption>
              <span>From Kähler geometry of a two-dimensional Brillouin zone to the quaternion-Kähler setting with three coupled Berry curvatures.</span>
              <a href="/research/quaternion-kahler-geometry.svg" target="_blank" rel="noopener noreferrer">View larger ↗</a>
            </figcaption>
          </figure>
        )}
        {section.ids.length>0 && <div class="related-papers"><h3>Related publications</h3>{section.ids.map(id=>paperById(id)).filter(Boolean).map(paper=><PaperCard paper={paper} compact />)}</div>}
      </div>
    </article>)}
  </section>
</SiteLayout>

<style>
  /* Research-only figure; no shared stylesheet changes. */
  .geometry-research-figure {
    width: min(100%, 820px);
    margin: 27px 0 33px;
  }
  .geometry-figure-visual {
    display: block;
    padding: clamp(10px, 2.5vw, 22px);
    border: 1px solid var(--line, #d9d9cc);
    border-radius: 4px;
    background: var(--surface, #fffcf6);
    transition: border-color .16s ease;
  }
  .geometry-figure-visual:hover { border-color: var(--accent, #285b49); }
  .geometry-figure-visual:focus-visible,
  .geometry-research-figure figcaption a:focus-visible {
    outline: 2px solid var(--accent, #285b49);
    outline-offset: 3px;
  }
  .geometry-figure-visual img {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    object-fit: contain;
  }
  .geometry-research-figure figcaption {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 22px;
    padding-top: 12px;
    color: var(--muted, #5c665f);
    font: 12px/1.6 var(--sans, sans-serif);
  }
  .geometry-research-figure figcaption span { max-width: 610px; }
  .geometry-research-figure figcaption a {
    color: var(--accent, #285b49);
    text-decoration: underline;
    text-underline-offset: 3px;
    white-space: nowrap;
  }
  @media (max-width: 600px) {
    .geometry-research-figure { margin: 23px 0 26px; }
    .geometry-figure-visual { padding: 8px; }
    .geometry-research-figure figcaption { font-size: 11.5px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .geometry-figure-visual { transition: none; }
  }
</style>
