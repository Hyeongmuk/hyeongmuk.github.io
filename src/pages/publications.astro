---
import SiteLayout from '../layouts/SiteLayout.astro';
import PaperCard from '../components/PaperCard.astro';
import TalkRow from '../components/TalkRow.astro';
import talksData from '../data/talks.json';
import SearchFilter from '../components/SearchFilter.astro';
import {publications} from '../lib/publications.mjs';
import {publicationCategories} from '../data/categories.mjs';
const talks=[...talksData].sort((a,b)=>b.date.localeCompare(a.date));
const years=[...new Set(publications.map(p=>p.year))];
const allTags=publications.flatMap(p=>p.tags?.length?p.tags:p.topics).filter(x=>x!=='Preprint');
const keywords=[...new Set(allTags)].sort((a,b)=>allTags.filter(x=>x===b).length-allTags.filter(x=>x===a).length || a.localeCompare(b));
const areas=publicationCategories.map(c=>({...c,count:publications.filter(p=>p.areas.includes(c.title)).length})).filter(c=>c.count>0);
---
<SiteLayout active="publications" page="publications" title="Publications · Hyeongmuk Lim">
  <header class="page-heading"><p class="eyebrow">RESEARCH OUTPUT</p><h1>Publications<span class="title-dot">.</span></h1><p>Research papers and preprints. Search by title, author, year, or topic, or select a keyword to narrow the collection.</p></header>
  <SearchFilter id="publications" placeholder="Search titles, authors, journals, keywords…" count={publications.length} categories={areas} keywords={keywords}/>
  <section class="publication-results" id="publications-results" data-search-root="publications">
    <div class="results-toolbar"><p role="status" aria-live="polite" data-result-count>{publications.length} publications</p></div>
    {years.map(year=><section class="year-group" data-filter-group>
      <h2 class="year-header">{year}</h2>
      {publications.filter(p=>p.year===year).map(paper=><div data-filter-item data-area={paper.areas.map(area=>publicationCategories.find(c=>c.title===area)?.id).filter(Boolean).join('|')} data-keywords={(paper.tags?.length?paper.tags:paper.topics).join('|')} data-search={[paper.title,paper.authors.join(' '),paper.journal,paper.year,paper.monthName,...paper.areas,...(paper.tags||[]),...paper.topics,paper.summary].filter(Boolean).join(' ')}><PaperCard paper={paper}/></div>)}
    </section>)}
    <div class="empty-state" data-empty-state hidden><h2>No matching publications</h2><p>Try another search or keyword.</p><button class="button-secondary" type="button" data-filter-reset>Clear filters</button></div>
    <p class="archive-footnote">For citations and publication information, see <a href="https://scholar.google.com/citations?user=bp9_2lwAAAAJ&amp;hl=en" target="_blank" rel="noopener noreferrer">Google Scholar ↗</a>.</p>
  </section>
  <section class="talks-section" id="talks" aria-labelledby="talks-heading">
    <h2 id="talks-heading">Talks</h2>
    {talks.map(talk=><TalkRow talk={talk}/>)}
  </section>
</SiteLayout>
