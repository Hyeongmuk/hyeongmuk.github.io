---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getCollection } from 'astro:content';
import '../../styles/notes-compact.css';

const notes = (await getCollection('notes', ({ data }) => data.status === 'published'))
  .sort((a,b) => b.data.date.getTime()-a.data.date.getTime());

const categories = [
  { id: 'qft', title: 'Quantum Field Theory', summary: 'Quantization, field theory, and the mathematical structures behind them.', number: '01' },
  { id: 'mathematics', title: 'Mathematics', summary: 'Algebra, geometry, topology, and categorical perspectives.', number: '02' },
  { id: 'condensed', title: 'Condensed Matter Physics', summary: 'Topological phases, quantum matter, and computational models.', number: '03' },
];
---
<SiteLayout active="notes" title="Study Notes · Hyeongmuk Lim">
  <section class="container page-intro notes-page-intro">
    <p class="eyebrow">PERSONAL LEARNING ARCHIVE</p>
    <h1>Notes from <em>ongoing study.</em></h1>
    <p class="intro-lead">A growing collection of study notes in quantum field theory, mathematics, and condensed matter physics. Selected manuscripts are available to read online as PDFs and to download.</p>
    <nav aria-label="Study note categories" class="notes-category-nav">
      {categories.map(category => <a href={`#${category.id}`}>{category.title} ↓</a>)}
    </nav>
  </section>
  <section class="container notes-list-section compact-notes-library">
    {categories.map(category => (
      <section id={category.id} class="notes-category-section" aria-label={category.title}>
        <div class="notes-category-heading">
          <span class="notes-category-num">{category.number} / STUDY AREA</span>
          <div>
            <h2>{category.title}</h2>
            <p>{category.summary}</p>
          </div>
        </div>
        <div class="notes-compact-list">
          {notes.filter(note => note.data.category === category.id).map(note => (
            <article class="study-note-row">
              <div class="study-note-info">
                <div class="study-note-meta">
                  <span>{note.data.topic}</span>
                  <span aria-hidden="true">·</span>
                  <span>{note.data.complete ? 'Complete note' : 'Study note'}</span>
                  {note.data.pages && <><span aria-hidden="true">·</span><span>{note.data.pages} pages</span></>}
                </div>
                <h3><a href={`/notes/${note.id}/`}>{note.data.title}</a></h3>
                <p>{note.data.description}</p>
              </div>
              <div class="study-note-links">
                <a class="study-note-overview" href={`/notes/${note.id}/`}>Overview →</a>
                {note.data.pdf && <a class="study-note-pdf" href={note.data.pdf} target="_blank" rel="noopener noreferrer" aria-label={`Read PDF: ${note.data.title} (opens a new tab)`}>Read PDF ↗</a>}
              </div>
            </article>
          ))}
        </div>
      </section>
    ))}
  </section>
</SiteLayout>
