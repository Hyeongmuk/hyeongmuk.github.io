---
import SiteLayout from '../../layouts/SiteLayout.astro';
import NoteCard from '../../components/NoteCard.astro';
import SearchFilter from '../../components/SearchFilter.astro';
import {getCollection} from 'astro:content';
import {noteCategories} from '../../data/categories.mjs';
const notes=(await getCollection('notes',({data})=>data.status==='published')).sort((a,b)=>b.data.date.getTime()-a.data.date.getTime());
const allTags=notes.flatMap(note=>note.data.tags);
const keywords=[...new Set(allTags)].sort((a,b)=>allTags.filter(x=>x===b).length-allTags.filter(x=>x===a).length || a.localeCompare(b));
---
<SiteLayout active="notes" page="notes" title="Study Notes · Hyeongmuk Lim">
  <header class="page-heading"><p class="eyebrow">PERSONAL LEARNING ARCHIVE</p><h1>Study notes<span class="title-dot">.</span></h1><p>Quantum field theory, mathematics, and condensed matter physics. Read manuscripts in a new PDF tab or download them for later.</p></header>
  <SearchFilter id="notes" placeholder="Search titles, subjects, or keywords…" count={notes.length} categories={noteCategories} keywords={keywords}/>
  <section class="notes-results" id="notes-results" data-search-root="notes">
    <div class="results-toolbar"><p role="status" aria-live="polite" data-result-count>{notes.length} notes</p><button type="button" class="filters-reset" data-filter-reset-all hidden>Clear filters</button></div>
    {noteCategories.map((category,index)=>{
      const list=notes.filter(note=>note.data.category===category.id);
      return <section class="note-group" id={category.id} data-filter-group>
        <div class="category-heading"><span class="category-number">{String(index+1).padStart(2,'0')}</span><h2>{category.title}</h2><span class="category-caption">{category.summary}</span></div>
        {list.map(note=><div data-filter-item data-area={category.id} data-keywords={note.data.tags.join('|')} data-search={[note.data.title,note.data.description,note.data.topic,category.title,...note.data.tags].join(' ')}><NoteCard note={note}/></div>)}
      </section>;
    })}
    <div class="empty-state" data-empty-state hidden><h2>No matching notes</h2><p>Try another search or keyword.</p><button class="button-secondary" type="button" data-filter-reset>Clear filters</button></div>
    <p class="archive-footnote">These are personal study notes, not peer-reviewed publications. Corrections and suggestions are welcome: <a href="mailto:ihm5024@snu.ac.kr">get in touch</a>.</p>
  </section>
</SiteLayout>
