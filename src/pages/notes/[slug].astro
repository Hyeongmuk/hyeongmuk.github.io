---
import SiteLayout from '../../layouts/SiteLayout.astro';
import {getCollection,render} from 'astro:content';
import {noteCategoryLabel} from '../../data/categories.mjs';
export async function getStaticPaths(){
 const entries=await getCollection('notes',({data})=>data.status==='published');
 return entries.map(entry=>({params:{slug:entry.id},props:{entry}}));
}
const {entry}=Astro.props;
const {Content}=await render(entry);
const d=entry.data;
// Treat note relationships as data, not as a second manually maintained list.
const published=await getCollection('notes',({data})=>data.status==='published');
const byId=new Map(published.map(note=>[note.id,note]));
const related=[];
const included=new Set();
for(const rel of d.relations){
  const note=byId.get(rel.note);
  if(!note || note.id===entry.id || included.has(note.id)) continue;
  included.add(note.id);
  related.push({note,label:rel.type==='supplement_to'?'Main note':rel.type==='companion'?'Companion note':'Related note',description:rel.description || note.data.description});
}
for(const note of published){
  if(note.id===entry.id || included.has(note.id)) continue;
  const reverse=note.data.relations.find(rel=>rel.note===entry.id);
  if(!reverse) continue;
  included.add(note.id);
  related.push({note,label:reverse.type==='supplement_to'?'Supplementary note':reverse.type==='companion'?'Companion note':'Related note',description:note.data.description});
}

---
<SiteLayout active="notes" page="note-detail" title={`${d.title} · Hyeongmuk Lim`} description={d.description}>
  <div class="breadcrumb"><a href="/notes/">Study notes</a><span aria-hidden="true">/</span><span>{noteCategoryLabel(d.category)}</span></div>
  <header class="detail-heading"><p class="eyebrow">{d.topic}</p><h1>{d.title}<span class="title-dot">.</span></h1><p class="detail-meta">{noteCategoryLabel(d.category)} · {d.date.getFullYear()}{d.pages?` · ${d.pages} pages`:''}{d.complete?' · Complete note':''}</p><p class="detail-description">{d.description}</p></header>
  <div class="detail-actions">
    {d.pdf && <a href={d.pdf} class="button" target="_blank" rel="noopener noreferrer">Read PDF ↗ <span class="sr-only">(opens in a new tab)</span></a>}
    {d.pdf && <a href={d.pdf} class="button-secondary" download>Download PDF ↓</a>}
    {d.downloads.map(file=><a class="button-secondary" href={file.href} download>{file.label} ↓</a>)}
  </div>
  <section class="detail-body note-detail-body">
    <div class="note-prose"><h2>About this note</h2><Content /></div>
    <div class="note-sidebar">
      <aside class="note-details-panel" aria-label="Note details">
        <p class="eyebrow">NOTE DETAILS</p>
        <h2>Topics</h2>
        <div class="detail-keywords">{d.tags.map(tag=><span>{tag}</span>)}</div>
        <p>Compiled PDF preserves the original LaTeX notation and layout.</p>
        <a class="text-link" href="/notes/">← Back to the archive</a>
      </aside>
      {related.length>0 && <aside class="related-notes-panel" aria-label="Related notes">
        <p class="eyebrow">CONNECTIONS</p>
        <h2>Related notes</h2>
        <div class="related-note-list">
          {related.map(({note,label,description})=><div class="related-note-item">
            <p class="related-note-kind">{label}</p>
            <h3><a href={`/notes/${note.id}/`}>{note.data.title} <span aria-hidden="true">→</span></a></h3>
            <p>{description}</p>
          </div>)}
        </div>
      </aside>}
    </div>
  </section>
</SiteLayout>

<style>
  /* The two panels share the existing sidebar column; other pages are unchanged. */
  .note-sidebar { display:flex; flex-direction:column; gap:16px; min-width:0; }
  .note-detail-body .note-sidebar aside { min-width:0; padding:24px; background:var(--tint); }
  .note-detail-body .related-notes-panel { border-top:2px solid var(--accent); }
  .note-detail-body .related-notes-panel h2 { margin-bottom:18px; }
  .related-note-item + .related-note-item { border-top:1px solid var(--line); padding-top:17px; margin-top:17px; }
  .related-note-kind { font-size:10px!important; letter-spacing:.07em; text-transform:uppercase; font-weight:650; color:var(--accent)!important; margin:0 0 5px; }
  .related-note-item h3 { font-size:19px; line-height:1.35; margin:0 0 6px; }
  .related-note-item a:hover { color:var(--accent); text-decoration:underline; }
  .related-note-item a:focus-visible { outline:2px solid var(--accent); outline-offset:3px; }
  .related-note-item>p:last-child { font-size:12.5px; line-height:1.65; margin-bottom:0; }
  @media(max-width:760px) { .note-sidebar{gap:12px} .note-detail-body .note-sidebar aside{padding:20px} }
</style>
