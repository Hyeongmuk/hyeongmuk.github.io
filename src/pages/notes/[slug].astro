---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => data.status === 'published');
  return notes.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const categories = {
  qft: 'Quantum Field Theory',
  mathematics: 'Mathematics',
  condensed: 'Condensed Matter Physics',
};
---
<SiteLayout active="notes" title={`${entry.data.title} · Study Notes`} description={entry.data.description}>
  <section class="container reading-header">
    <a class="crumb" href="/notes/">← Back to all study notes</a>
    <p class="eyebrow">{categories[entry.data.category]} / {entry.data.topic}</p>
    <h1>{entry.data.title}</h1>
    <p class="intro-lead">{entry.data.description}</p>
    <div class="reading-metadata">
      <span>{entry.data.complete ? 'Complete study note' : 'Open study resource'}</span>
      {entry.data.pages && <span>{entry.data.pages} pages</span>}
      <span>{entry.data.date.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' })}</span>
    </div>
    <div class="reading-actions">
      {entry.data.pdf && <>
        <a class="button-primary" href={entry.data.pdf} target="_blank" rel="noopener noreferrer">Read PDF in a new tab ↗</a>
        <a class="button-outline" href={entry.data.pdf} download>Download PDF ↓</a>
      </>}
      {entry.data.downloads.map(file => <a class="button-outline" href={file.href} download>{file.label} ↓</a>)}
    </div>
  </section>
  <section class="container reader-wrap">
    <article class="prose"><Content /></article>
    {entry.data.pdf && <details class="pdf-optional-preview">
      <summary>Preview PDF on this page (optional)</summary>
      <div class="pdf-panel">
        <p>For the full reading experience, use the Read PDF button above. Some mobile browsers do not support inline PDF viewing.</p>
        <iframe title={`PDF preview: ${entry.data.title}`} src={`${entry.data.pdf}#toolbar=1`} loading="lazy"></iframe>
      </div>
    </details>}
  </section>
</SiteLayout>
